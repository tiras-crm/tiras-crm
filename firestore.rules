// TIRAS CRM — Firestore Security Rules
// Version 1.0 | May 2026
//
// ROLE HIERARCHY (from master doc Section 6):
//   platform_owner  → reads/writes ALL companies, ALL collections
//   company_admin   → reads/writes only own companyId
//   manager         → reads own companyId, writes scoped to own agents only
//   agent           → reads/writes only own assigned leads + own calls
//   support_agent   → reads/writes only tickets assigned to them
//
// ZERO LOOPHOLES POLICY:
//   - No agent can read another agent's leads
//   - No manager can read another company's data
//   - No company can read another company's data — ever
//   - platform_owner account is created manually — not via app signup
//   - All rules default to DENY — only explicitly allowed paths are open
//
// HOW TO DEPLOY:
//   firebase deploy --only firestore:rules
//
// HOW TO TEST:
//   firebase emulators:start --only firestore
//   Use Firebase Emulator Suite → Firestore → Rules Playground

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════════

    // Is the request from a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    // Get the caller's user profile from Firestore
    // Cached per request — Firestore does not charge extra reads for this
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role checks — read role from Firestore user document
    function isPlatformOwner() {
      return isAuth() && getUserData().role == 'platform_owner';
    }

    function isCompanyAdmin() {
      return isAuth() && getUserData().role == 'company_admin';
    }

    function isManager() {
      return isAuth() && getUserData().role == 'manager';
    }

    function isAgent() {
      return isAuth() && getUserData().role == 'agent';
    }

    function isSupportAgent() {
      return isAuth() && getUserData().role == 'support_agent';
    }

    // Company membership check — caller must belong to this companyId
    function belongsToCompany(companyId) {
      return isAuth() && getUserData().companyId == companyId;
    }

    // Caller is admin OR platform owner for a given company
    function isAdminForCompany(companyId) {
      return isPlatformOwner() ||
             (isCompanyAdmin() && belongsToCompany(companyId));
    }

    // Caller is manager OR admin for this company
    function isManagerOrAbove(companyId) {
      return isPlatformOwner() ||
             (isCompanyAdmin() && belongsToCompany(companyId)) ||
             (isManager() && belongsToCompany(companyId));
    }

    // Caller is the specific manager of a given agent
    function isManagerOf(agentId) {
      return isAuth() &&
             isManager() &&
             get(/databases/$(database)/documents/users/$(agentId)).data.managerId == request.auth.uid;
    }

    // Caller is the agent themselves
    function isSelf(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Incoming data has a companyId that matches caller's companyId
    // Prevents agents from writing data into another company
    function writingToOwnCompany() {
      return isAuth() &&
             request.resource.data.companyId == getUserData().companyId;
    }

    // Document's companyId matches caller's companyId
    function docBelongsToCallerCompany() {
      return isAuth() &&
             resource.data.companyId == getUserData().companyId;
    }

    // Caller is active (not deactivated by admin)
    function isActive() {
      return isAuth() && getUserData().isActive == true;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // USERS COLLECTION
    // /users/{userId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: uid, email, displayName, role, companyId, managerId, isActive

    match /users/{userId} {

      // Read own profile — any authenticated active user
      allow read: if isAuth() && isActive() && isSelf(userId);

      // Platform owner reads any user profile (for support and onboarding)
      allow read: if isPlatformOwner() && isActive();

      // Company admin reads all users in their company
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager reads users in their company (to see agent profiles)
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Create user — only platform_owner creates users manually
      // Company admin creates agents/managers via admin panel (also allowed)
      allow create: if isPlatformOwner() && isActive();
      allow create: if isActive() &&
                       isCompanyAdmin() &&
                       request.resource.data.companyId == getUserData().companyId &&
                       request.resource.data.role in ['agent', 'manager', 'support_agent'];

      // Update own profile — limited fields only (name, password handled by Auth, not Firestore)
      allow update: if isActive() &&
                       isSelf(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'companyId', 'isActive', 'managerId']);

      // Admin updates any user in their company (activate/deactivate, reassign manager)
      allow update: if isActive() &&
                       isAdminForCompany(resource.data.companyId);

      // Platform owner updates any user
      allow update: if isPlatformOwner() && isActive();

      // Delete — platform owner only
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // COMPANIES COLLECTION
    // /companies/{companyId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: name, plan, billingStatus, onboardedAt, agentCount, adminUid

    match /companies/{companyId} {

      // Platform owner — full access to all companies
      allow read, write: if isPlatformOwner() && isActive();

      // Company admin reads their own company document only
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     request.auth.uid != null &&
                     getUserData().companyId == companyId;

      // Company admin updates their own company settings (name, logo, WhatsApp templates)
      // Cannot change: plan, billingStatus — those are platform owner only
      allow update: if isActive() &&
                       isCompanyAdmin() &&
                       getUserData().companyId == companyId &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['plan', 'billingStatus', 'onboardedAt']);

      // Managers and agents cannot write to company document
      allow create, delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // LEADS COLLECTION
    // /leads/{leadId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: name, phone, email, stage, assignedTo (agentId), companyId,
    //         managerId, source, temperature, dealValue, customFields

    match /leads/{leadId} {

      // Platform owner — reads any lead on the platform
      allow read: if isPlatformOwner() && isActive();

      // Company admin — reads all leads in their company
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager — reads all leads assigned to agents in their company
      // (manager sees their team's leads — not other managers' agents)
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Agent — reads ONLY their own assigned leads
      // Core isolation rule: agent cannot see leads assigned to other agents
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.assignedTo == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Support agent — reads leads linked to their assigned tickets only
      // (checked via ticket lookup — support agent cannot browse leads directly)
      // Simplified: support agents get read access to leads in their company
      allow read: if isActive() &&
                     isSupportAgent() &&
                     resource.data.companyId == getUserData().companyId;

      // Create lead — agent, manager, admin (all within own company)
      allow create: if isActive() &&
                       writingToOwnCompany() &&
                       (isAgent() || isManager() || isCompanyAdmin()) &&
                       request.resource.data.keys().hasAll(['leadId', 'companyId', 'phone']);

      // Update lead — agent updates only their own leads
      allow update: if isActive() &&
                       isAgent() &&
                       resource.data.assignedTo == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId &&
                       // Agent cannot reassign lead to another agent
                       request.resource.data.assignedTo == resource.data.assignedTo;

      // Manager updates any lead in their company
      allow update: if isActive() &&
                       isManager() &&
                       resource.data.companyId == getUserData().companyId;

      // Admin updates any lead in their company
      allow update: if isActive() &&
                       isAdminForCompany(resource.data.companyId);

      // Platform owner updates any lead
      allow update: if isPlatformOwner() && isActive();

      // Delete — admin and platform owner only (agents cannot delete leads)
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // CALLS COLLECTION
    // /calls/{callId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: leadId, agentId, companyId, duration, outcome, recordingUrl,
    //         aiSummary, objectionTag, temperature, status

    match /calls/{callId} {

      // Platform owner — reads any call
      allow read: if isPlatformOwner() && isActive();

      // Admin — reads all calls in their company (recordings library)
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager — reads all calls in their company
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Agent — reads only their own calls
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.agentId == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Support agent — reads calls linked to their tickets (company scope)
      allow read: if isActive() &&
                     isSupportAgent() &&
                     resource.data.companyId == getUserData().companyId;

      // Create call log — agent only, for their own calls, in their company
      allow create: if isActive() &&
                       isAgent() &&
                       writingToOwnCompany() &&
                       request.resource.data.agentId == request.auth.uid;

      // Update call — agent updates their own active calls (outcome, notes, temperature)
      allow update: if isActive() &&
                       isAgent() &&
                       resource.data.agentId == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId;

      // Manager/admin can update call records (e.g. override outcome, add notes)
      allow update: if isActive() && isManagerOrAbove(resource.data.companyId);

      // Platform owner updates any call
      allow update: if isPlatformOwner() && isActive();

      // Delete — admin and platform owner only (for TTL cleanup via Cloud Function)
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // TICKETS COLLECTION
    // /tickets/{ticketId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: leadId, callId, raisedBy, assignedTo (support agent uid),
    //         companyId, status, priority, timeline (array of events)

    match /tickets/{ticketId} {

      // Platform owner — reads all tickets
      allow read: if isPlatformOwner() && isActive();

      // Admin — reads all tickets in their company
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager — reads all tickets in their company
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Agent — reads tickets they raised
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.raisedBy == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Support agent — reads ONLY tickets assigned to them
      // Core isolation for support role
      allow read: if isActive() &&
                     isSupportAgent() &&
                     resource.data.assignedTo == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Create ticket — any authenticated active user in the company
      allow create: if isActive() &&
                       writingToOwnCompany() &&
                       request.resource.data.raisedBy == request.auth.uid;

      // Update ticket — support agent updates only their assigned tickets
      allow update: if isActive() &&
                       isSupportAgent() &&
                       resource.data.assignedTo == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId &&
                       // Support agent cannot reassign ticket to themselves or change company
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['companyId', 'raisedBy']);

      // Manager/admin update any ticket (assign, escalate, close)
      allow update: if isActive() && isManagerOrAbove(resource.data.companyId);

      // Platform owner updates any ticket
      allow update: if isPlatformOwner() && isActive();

      // Delete — admin and platform owner only
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // FOLLOW-UPS COLLECTION
    // /followups/{followupId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: leadId, agentId, companyId, scheduledAt, isCompleted, isOverdue

    match /followups/{followupId} {

      // Platform owner
      allow read, write: if isPlatformOwner() && isActive();

      // Admin — reads/writes all follow-ups in company
      allow read, write: if isActive() &&
                            isAdminForCompany(resource.data.companyId);

      // Manager — reads all follow-ups in company, updates to mark overdue
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      allow update: if isActive() &&
                       isManager() &&
                       resource.data.companyId == getUserData().companyId;

      // Agent — full control over their own follow-ups only
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.agentId == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      allow create: if isActive() &&
                       isAgent() &&
                       writingToOwnCompany() &&
                       request.resource.data.agentId == request.auth.uid;

      allow update: if isActive() &&
                       isAgent() &&
                       resource.data.agentId == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId;

      allow delete: if isActive() &&
                       isAgent() &&
                       resource.data.agentId == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // NOTIFICATIONS COLLECTION
    // /notifications/{notificationId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: recipientUid, companyId, type, title, body, isRead, createdAt

    match /notifications/{notificationId} {

      // Platform owner reads all notifications
      allow read: if isPlatformOwner() && isActive();

      // Any user reads only their own notifications
      allow read: if isActive() &&
                     resource.data.recipientUid == request.auth.uid;

      // Company-wide notifications (no recipientUid) — admin and manager can read
      allow read: if isActive() &&
                     isManagerOrAbove(resource.data.companyId) &&
                     !('recipientUid' in resource.data);

      // Create notifications — Cloud Functions write these (admin SDK bypasses rules)
      // From frontend: only admin can create company-wide notifications
      allow create: if isActive() && isAdminForCompany(request.resource.data.companyId);

      // Update — user marks their own notification as read
      allow update: if isActive() &&
                       resource.data.recipientUid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isRead', 'readAt']);

      // Delete — user deletes their own notification
      allow delete: if isActive() &&
                       resource.data.recipientUid == request.auth.uid;

      // Admin deletes any notification in their company
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAYMENTS COLLECTION
    // /payments/{paymentId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: leadId, agentId, companyId, amount, status, razorpayPaymentId

    match /payments/{paymentId} {

      // Platform owner — reads all payments (billing management)
      allow read: if isPlatformOwner() && isActive();

      // Admin — reads all payments in their company
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager — reads payments in their company (pipeline value tracking)
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Agent — reads payments they created
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.agentId == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Create payment record — agent creates for their own leads
      allow create: if isActive() &&
                       isAgent() &&
                       writingToOwnCompany() &&
                       request.resource.data.agentId == request.auth.uid;

      // Admin creates payment record (e.g. manual payment entry)
      allow create: if isActive() && isAdminForCompany(request.resource.data.companyId);

      // Update — agent updates payment they created (add invoice flag, notes)
      allow update: if isActive() &&
                       isAgent() &&
                       resource.data.agentId == request.auth.uid &&
                       resource.data.companyId == getUserData().companyId &&
                       // Agent cannot change amount or status after creation
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['amount', 'status', 'razorpayPaymentId']);

      // Admin updates any payment in their company
      allow update: if isActive() && isAdminForCompany(resource.data.companyId);

      // Platform owner updates any payment
      allow update: if isPlatformOwner() && isActive();

      // Delete — admin and platform owner only
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PIPELINE STAGES COLLECTION
    // /pipeline_stages/{stageId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: companyId, name, order, color, isDefault

    match /pipeline_stages/{stageId} {

      // Any authenticated user in the company can read stages
      // (agents need to read stages to display the Kanban board)
      allow read: if isActive() &&
                     resource.data.companyId == getUserData().companyId;

      allow read: if isPlatformOwner() && isActive();

      // Only admin can create/modify/delete pipeline stages
      allow create, update, delete: if isActive() &&
                                       isAdminForCompany(request.resource.data.companyId);

      allow create, update, delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // WHATSAPP TEMPLATES COLLECTION
    // /wa_templates/{templateId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: companyId, name, body, type (introduction/followup/payment/thank_you)

    match /wa_templates/{templateId} {

      // Any user in the company can read templates (agents use them on lead page)
      allow read: if isActive() &&
                     resource.data.companyId == getUserData().companyId;

      allow read: if isPlatformOwner() && isActive();

      // Only admin can create/modify/delete templates
      allow create, update, delete: if isActive() &&
                                       isAdminForCompany(request.resource.data.companyId);

      allow create, update, delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // LEAD TIMELINE COLLECTION
    // /lead_timeline/{eventId}
    // ═══════════════════════════════════════════════════════════════════════
    // Stores: leadId, type, note, agentId, companyId, createdAt
    // Append-only log — no updates or deletes (except admin TTL cleanup)

    match /lead_timeline/{eventId} {

      // Platform owner reads all timeline events
      allow read: if isPlatformOwner() && isActive();

      // Admin reads all timeline events in their company
      allow read: if isActive() &&
                     isCompanyAdmin() &&
                     resource.data.companyId == getUserData().companyId;

      // Manager reads timeline events in their company
      allow read: if isActive() &&
                     isManager() &&
                     resource.data.companyId == getUserData().companyId;

      // Agent reads timeline events for their own leads only
      allow read: if isActive() &&
                     isAgent() &&
                     resource.data.agentId == request.auth.uid &&
                     resource.data.companyId == getUserData().companyId;

      // Support agent reads timeline events in their company
      allow read: if isActive() &&
                     isSupportAgent() &&
                     resource.data.companyId == getUserData().companyId;

      // Create timeline event — any active user in the company
      // Timeline is append-only from the frontend
      allow create: if isActive() &&
                       writingToOwnCompany() &&
                       request.resource.data.agentId == request.auth.uid;

      // Admin can create timeline events on behalf of team
      allow create: if isActive() && isAdminForCompany(request.resource.data.companyId);

      // NO UPDATE allowed from frontend — timeline is immutable
      allow update: if false;

      // Delete — admin only (bulk cleanup) and platform owner
      allow delete: if isActive() && isAdminForCompany(resource.data.companyId);
      allow delete: if isPlatformOwner() && isActive();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════════════════
    // Any collection not explicitly listed above is completely locked
    // This is Firestore's default but stated explicitly for clarity

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
