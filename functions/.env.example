# TIRAS CRM V2 — Cloud Functions Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your real values.
# Deploy secrets with: firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#
# NOTE: For production use Firebase Secret Manager (recommended):
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#   Then reference in index.js via runWith({ secrets: ["RAZORPAY_WEBHOOK_SECRET"] })
#
# For local emulator testing only — create a .env file in the functions/ folder:

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Your Razorpay webhook secret — found in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Your Razorpay Key ID (used for server-side API calls if needed)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx

# Your Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Plivo ─────────────────────────────────────────────────────────────────────
# Plivo Auth ID — used to verify webhook origin if needed
PLIVO_AUTH_ID=your_plivo_auth_id_here

# Plivo Auth Token
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here

# ── Firebase ──────────────────────────────────────────────────────────────────
# These are auto-set in Cloud Functions — no need to set manually in production
# Only needed for local testing outside the emulator
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
